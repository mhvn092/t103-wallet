# Application
NODE_ENV=development
APP_ENV=local
SWAGGER_ENABLED=true
PORT=3000
APP_PUBLIC_URL=http://app:3000

# PostgreSQL (single transactional source of truth)
POSTGRES_USER=t103
POSTGRES_PASSWORD=change_me_local_pg_pass
POSTGRES_DB=t103_wallet
POSTGRES_PORT=5432
DATABASE_URI=postgresql://t103:change_me_local_pg_pass@localhost:5432/t103_wallet
# Optional least-privilege runtime role & separate migration owner URI (used in Compose)
# MIGRATION_DATABASE_URI=postgresql://t103:change_me_local_pg_pass@localhost:5432/t103_wallet
POSTGRES_APP_USER=t103_app
POSTGRES_APP_PASSWORD=change_me_local_app_pass

# RabbitMQ (bonus event broker; non-blocking if down)
RABBITMQ_DEFAULT_USER=t103_rmq
RABBITMQ_DEFAULT_PASS=change_me_local_rmq_pass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URI=amqp://t103_rmq:change_me_local_rmq_pass@localhost:5672?heartbeat=60

# External Simulator (PSP & Payout)
SIMULATOR_PORT=8080
SIM_CHAOS=default
SIM_TIME_SCALE=1
PSP_BASE_URL=http://localhost:8080
PAYOUT_BASE_URL=http://localhost:8080
WEBHOOK_SECRET=change_me_local_webhook_secret

# Optional Internal Ops Guards (empty in local dev; fail-closed in production)
INTERNAL_API_KEY=
INTERNAL_ALLOWED_IPS=
TRUST_PROXY=

# Health & Worker Tuning
READINESS_DB_TIMEOUT_MS=2000
WD_MANUAL_REVIEW_SLA_MS=1800000
DEPOSIT_EXPIRY_GRACE_MS=900000
RECONCILIATION_TZ=UTC
RETENTION_CLEANUP_INTERVAL_MS=300000
DRIFT_AUDIT_INTERVAL_MS=60000

# Financial Policy & Worker Tuning
MIN_WITHDRAWAL_IRT=100000
MIN_WITHDRAWAL_USDT=10
USDT_WITHDRAWAL_FEE=1
DAILY_LIMIT_IRT=200000000
USDT_IRT_RATE=60000
DEPOSIT_TTL_SECONDS=1800
PROVIDER_HTTP_TIMEOUT_MS=10000
WORKER_POLL_INTERVAL_MS=1000
WORKERS_ENABLED=true
